# PurpleLoop needs no secrets, model credentials, or cloud accounts. All model responses are
# offline fixtures and every target is a local synthetic fixture.
PURPLELOOP_LOG_LEVEL=INFO

# The Phase 1 fixture's customer and control credentials are synthetic, generated per run, and
# injected into Compose by the harness. Do not set them here.
#   PURPLELOOP_CUSTOMER_CREDENTIAL / PURPLELOOP_CONTROL_CREDENTIAL

# Set to 1 to opt into the container acceptance lane, which needs Docker:
#   PURPLELOOP_CONTAINER_TESTS=1 uv run pytest tests/phase1/test_isolation.py --no-cov
PURPLELOOP_CONTAINER_TESTS=0
